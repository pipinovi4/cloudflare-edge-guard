# Copy to /etc/cloudflare-edge-guard/config.env and edit as root.
DOMAIN=example.com
ENABLE_WWW=true
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8080
HEALTHCHECK_PATH=/health
ENABLE_NGINX=true
ENABLE_HTTP_REDIRECT=true
ENABLE_ORIGIN_TLS=true
ORIGIN_CERT_PATH=/etc/nginx/ssl/cloudflare-origin.pem
ORIGIN_KEY_PATH=/etc/nginx/ssl/cloudflare-origin.key
ENABLE_UFW=true
SSH_PORT=22
ENABLE_CLOUDFLARE_EDGE_GUARD=true
ENABLE_IPV6=true
CLOUDFLARE_IPV4_URL=https://www.cloudflare.com/ips-v4
CLOUDFLARE_IPV6_URL=https://www.cloudflare.com/ips-v6
ENABLE_AUTOMATIC_UPDATES=true
UPDATE_SCHEDULE=04:00
LOG_FILE=/var/log/cloudflare-edge-guard.log
STATE_DIR=/var/lib/cloudflare-edge-guard
BACKUP_DIR=/var/backups/cloudflare-edge-guard
DRY_RUN=false
